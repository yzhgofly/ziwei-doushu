# 复制为 .env.local 后填入实际值

# ─── AI 解读 / 合盘分析（/api/interpret、/api/heming）───
# 本地跑排盘不需要任何 Key；下面这组只在你接上 AI 解读时才需要。
#
# 协议二选一：
#   anthropic —— Anthropic Messages 协议（{base}/messages）
#   openai    —— OpenAI 兼容协议（{base}/chat/completions），DeepSeek / MiMo / OpenAI 等
#
# 鉴权方式 AI_AUTH_MODE：
#   api-key —— 请求头 x-api-key: <key>（Anthropic 官方默认）
#   bearer  —— 请求头 Authorization: Bearer <key>（OpenAI 兼容网关、私有端点常用）
#
# 通用的覆盖项（优先级高于预设）：
#   AI_PROTOCOL / AI_BASE_URL / AI_API_KEY / AI_MODEL

# 方式一：直接指定协议与端点（推荐，最灵活）
AI_PROVIDER=anthropic
AI_PROTOCOL=anthropic
AI_BASE_URL=https://api.anthropic.com/v1
AI_AUTH_MODE=api-key
AI_API_KEY=your-api-key
AI_MODEL=your-model-id

# 方式二：用预设名（.env.example 旧写法也认）
#   AI_PROVIDER=deepseek  → OpenAI 兼容协议 + https://api.deepseek.com/v1 + DEEPSEEK_API_KEY
#   AI_PROVIDER=mimo      → OpenAI 兼容协议 + MIMO_BASE_URL / MIMO_API_KEY / MIMO_MODEL
#   AI_PROVIDER=openai    → OpenAI 兼容协议 + https://api.openai.com/v1 + OPENAI_API_KEY
#
# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# 单次输出上限与超时（毫秒）
#   AI_MAX_TOKENS 是「思考 + 正文」共用的预算。带 thinking 的模型（MiniMax M3 等）
#   会先花掉一大截做思考，给小了会在正文开始前就被截断 —— 表现是「正文一个字都没有」。
#   默认 16384；用 DeepSeek 时它最高输出 8K，请设 AI_MAX_TOKENS=8192。
AI_MAX_TOKENS=16384
AI_TIMEOUT_MS=180000

# ─── 公网暴露时的额度保护（/api/interpret、/api/heming 必过这道闸）───
# 排盘本身不花钱，但 AI 解读要打模型。站点一旦开到公网，
# 任何拿到链接的人都能调这两个接口消耗你的 API Key 额度，所以默认就带限流：
#
#   AI_RATE_LIMIT_WINDOW_MS   滑动窗口长度，默认 60000（1 分钟）
#   AI_RATE_LIMIT_PER_WINDOW  同一个来源在一个窗口内最多放行几次，默认 6
#   AI_MAX_CONCURRENT         全局同时进行的模型调用数上限，默认 2
#   AI_DAILY_REQUEST_CAP      全局每日最多放行多少次，默认 60（设 0 表示不限）
#
# 本机自用可以把上限调高；对外分享则建议保持默认甚至更严。
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_PER_WINDOW=6
AI_MAX_CONCURRENT=2
AI_DAILY_REQUEST_CAP=60

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
